name: Tu dong quet bu hinh anh hang ngay

on:
  schedule:
    # Lịch chạy tự động mỗi ngày vào lúc 2 giờ sáng (Giờ UTC, tương đương 9 giờ sáng giờ Việt Nam)
    - cron: '0 2 * * *'
  workflow_dispatch: # Cho phép thầy bấm nút chạy thủ công bất cứ lúc nào trên web GitHub

jobs:
  run-image-scanner:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout ma nguon
        uses: actions/checkout@v3

      - name: Cai dat moi truong Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Cai dat cac thu vien phu thuoc
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-chenanh.txt

      - name: Chay script quet bu hinh anh tu Google Drive
        env:
          # Đảm bảo tệp credentials.json đã được bảo mật hoặc lưu trong kho
          PYTHONIOENCODING: utf-8
        run: |
          python quet_bu_hinh_anh.py
